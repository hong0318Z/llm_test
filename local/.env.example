# 로컬 oMLX (OpenAI 호환) 서버 연동 설정
# oMLX 실행 후 노출되는 base URL
LLM_BASE_URL=http://127.0.0.1:8000/v1

# oMLX에 로드된 모델명 (oMLX 모델 설정 화면의 "모델" 컬럼 값)
LLM_MODEL=mlx-community--gemma-4-26b-a4b-it-8bit

# oMLX는 보통 키 검증을 하지 않지만, 클라이언트 라이브러리가 빈 값을 거부하므로 임의 문자열을 넣어둡니다.
# 실제 키가 필요하다면 여기에 직접 입력하세요.
LLM_API_KEY=local-omlx-key

# Flask 설정
SECRET_KEY=change-this-in-production

# 포트 설정 (원본 앱과 충돌하지 않도록 5002 사용)
PORT=5002
