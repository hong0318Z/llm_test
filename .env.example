# GitHub Copilot API (아래 LLM_BASE_URL이 비어있을 때 사용)
# https://api.githubcopilot.com/chat/completions 사용
# GitHub Personal Access Token (Copilot 권한 포함) 입력
GITHUB_TOKEN=your_github_token_here

# 모델명 (기본값: claude-sonnet-4.5)
LLM_MODEL=claude-sonnet-4.5

# OpenAI 호환 로컬 LLM (Ollama 예: http://192.168.0.10:11434/v1)
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=local-no-key
# LLM_MODEL=qwen3:8b
# 선택적 임베딩. Ollama는 같은 URL과 nomic-embed-text 또는 bge-m3를 지원합니다.
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_MODEL=nomic-embed-text

# Flask 설정
SECRET_KEY=change-this-in-production

# 포트 설정 (맥은 5000이 AirPlay에 점유됨 → 5001 권장)
PORT=4318
